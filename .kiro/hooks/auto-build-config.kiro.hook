{
    "name": "Auto-build Configuration",
    "version": "1.0.0",
    "description": "Automatically runs npm run build when emc.mjs or 🐶.mjs files are saved, regenerating the JSON configuration files",
    "when": {
        "type": "fileEdited",
        "patterns": ["emc.mjs", "🐶.mjs"]
    },
    "then": {
        "type": "runCommand",
        "command": "npm run build"
    }
}
