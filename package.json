{
  "name": "fetch-for",
  "type": "module",
  "version": "0.0.11",
  "description": "Base class for web components as a service",
  "main": "fetch-for.js",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements"
  ],
  "exports": {
    ".": "./fetch-for.js",
    "./fetch-for.js": "./fetch-for.js",
    "./emc.mjs": "./emc.mjs",
    "./🐶.mjs": "./🐶.mjs"
  },
  "files": [
    "*.js",
    "*.mjs",
    "*.json",
    "./types/fetch-for/types.d.ts",
    "README.md"
  ],
  "types": "./types/fetch-for/types.d.ts",
  "scripts": {
    "build": "node emc.mjs > emc.json && node 🐶.mjs > 🐶.json",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "be-hive": "0.1.15",
    "fetch-ready": "0.0.1",
    "mount-observer": "0.1.41",
    "roundabout-lib": "0.0.23",
    "nested-regex-groups": "0.0.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@power-elements/json-viewer": "2.1.1",
    "be-reformable": "0.0.80",
    "spa-ssi": "0.0.27"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/fetch-for.git"
  },
  "author": "Bruce B. Anderson (anderson.bruce.b@gmail.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/fetch-for/issues"
  },
  "homepage": "https://github.com/bahrus/fetch-for#readme"
}
